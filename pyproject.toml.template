[project]
name = "myproject"
version = "0.1.0"
requires-python = ">=3.10"
dependencies = [
    "torch>=2.7",
    "torchvision",
]

# for CUDA 12.8, adjust as needed (cu118, cu138 etc.)
[tool.uv.sources]
torch = [{ index = "pytorch-cu128" }]
torchvision = [{ index = "pytorch-cu128" }]

[[tool.uv.index]]
name = "pytorch-cu128"
url = "https://download.pytorch.org/whl/cu128"
explicit = true
